# Transcripts — ElevenLabs Scribe (speech-to-text with word timestamps).
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Moment selection (Claude Haiku, ~$0.02 per video) and output moderation of AI images/video.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# AI images/video/voice/sound through fal.ai (models with `provider: fal` in ai-models.json),
# and fal's image safety check (a second opinion in output moderation when set).
FAL_KEY=

# Output review: Claude (Haiku vision) checks AI images/video against Creem's rules
# (packages/contracts/creem-policy.json) with ANTHROPIC_API_KEY, plus fal's NSFW check. Without it the
# worker skips the review in dev and refuses in production.

# --- Tùy chọn ---
# Speech-to-text model. Empty uses scribe_v1.
# OPENCMO_SCRIBE_MODEL=scribe_v1

# Explainer images (kit.Image) with OPENCMO_MOTION=local: the only origin a preview may fetch the user's
# images from (the Supabase URL). Renders get them inlined by the worker and do not need it.
# OPENCMO_MOTION_ASSET_ORIGIN=http://127.0.0.1:54321

# Creem's prompt screening, repeated just before a model is called. Same key as the web.
CREEM_API_KEY=

# --- Deployed worker (the Modal secret `opencmo`) ---
# The web app's public URL: the worker's clock calls its cron routes with CRON_SECRET.
# OPENCMO_WEB_URL=https://opencmo.io
# CRON_SECRET=
# Checks calls to the `look` endpoint (frame captures for the MCP server); same value as in `opencmo-mcp`.
# OPENCMO_LOOK_TOKEN=
# 1 pauses every founder's brain; the clock skips its calls (same switch as on the web app).
# OPENCMO_CMO_PAUSED=
# Posting through Zernio runs on the web app (ZERNIO_API_KEY, ZERNIO_WEBHOOK_SECRET, OPENCMO_PUBLISH_LIVE there);
# the worker uploads media only to Zernio's storage, plus any host listed here (comma-separated):
# OPENCMO_PUBLISH_UPLOAD_HOSTS=

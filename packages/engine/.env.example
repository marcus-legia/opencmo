# Transcripts — ElevenLabs Scribe (speech-to-text with word timestamps).
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Moment selection (Claude Haiku, ~$0.02 per video) and output moderation of AI images/video.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# AI images/video/voice/sound through fal.ai (models with `provider: fal` in ai-models.json),
# and fal's image safety check (a second opinion in output moderation when set).
FAL_KEY=

# Output moderation: a vision model checks AI images/video against the product rules, on the first
# provider of CMO_LLM_PROVIDERS (default openai,anthropic,gemini) with a key, the next one when it
# cannot answer. Without any of these keys the worker skips output moderation; the web turns AI
# images/video off in production. `openai` is Groq unless OPENAI_COMPAT_BASE_URL says otherwise.
# GROQ_API_KEY goes only to Groq: another endpoint needs OPENAI_COMPAT_API_KEY.
# GROQ_API_KEY=
# OPENCMO_MODERATION_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GEMINI_API_KEY=

# --- Tùy chọn ---
# Speech-to-text model. Empty uses scribe_v1.
# OPENCMO_SCRIBE_MODEL=scribe_v1

# Explainer images (kit.Image) with OPENCMO_MOTION=local: the only origin a preview may fetch the user's
# images from (the Supabase URL). Renders get them inlined by the worker and do not need it.
# OPENCMO_MOTION_ASSET_ORIGIN=http://127.0.0.1:54321

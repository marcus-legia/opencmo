/**
 * Compiles the skill library (`styles/*.md`, and `playbooks/`, `guides/` once they move here) into
 * `src/index.gen.ts`.
 *
 * Why generate TS instead of reading markdown at run time: serverless routes on Vercel do not ship
 * stray files, and a fixed string in the bundle keeps the Assistant's prompt cache stable.
 *
 *   tsx scripts/build-skills.mts          # write the file
 *   tsx scripts/build-skills.mts --check  # check:contracts: fails when the file is stale or a skill is invalid
 *
 * Rules: frontmatter passes `SkillFrontmatterSchema` (known capabilities, a valid preset), the name
 * matches the file and is unique across kinds, the kind matches its folder, the body is at most
 * MAX_BODY_CHARS.
 */

import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

import { parse } from 'yaml';

import { KIND_DIRS, MAX_BODY_CHARS, SKILL_KINDS, SkillFrontmatterSchema } from '../src/format.ts';

const ROOT = join(import.meta.dirname, '..');
const OUT = join(ROOT, 'src', 'index.gen.ts');

type Built = { name: string; kind: string; description: string; requires: string[]; preset?: unknown; body: string };

function load(dir: string, file: string): Built {
	const where = `${dir}/${file}`;
	const raw = readFileSync(join(ROOT, dir, file), 'utf8').replace(/\r\n/g, '\n');
	const match = /^---\n([\s\S]*?)\n---\n([\s\S]*)$/.exec(raw);
	if (!match) throw new Error(`${where}: missing frontmatter`);
	let meta: unknown;
	try {
		meta = parse(match[1]!);
	} catch (error) {
		throw new Error(`${where}: frontmatter is not valid YAML (${(error as Error).message})`);
	}
	const parsed = SkillFrontmatterSchema.safeParse(meta);
	if (!parsed.success) {
		const issue = parsed.error.issues[0]!;
		throw new Error(`${where}: ${issue.path.join('.') || 'frontmatter'}: ${issue.message}`);
	}
	const skill = parsed.data;
	if (`${skill.name}.md` !== file) throw new Error(`${where}: name "${skill.name}" must match the file name`);
	if (KIND_DIRS[skill.kind] !== dir) throw new Error(`${where}: a ${skill.kind} belongs in ${KIND_DIRS[skill.kind]}/`);
	const body = match[2]!.trim();
	if (!body) throw new Error(`${where}: empty body`);
	if (body.length > MAX_BODY_CHARS) throw new Error(`${where}: body is ${body.length} characters; the limit is ${MAX_BODY_CHARS}`);
	return { name: skill.name, kind: skill.kind, description: skill.description, requires: skill.requires, ...(skill.preset ? { preset: skill.preset } : {}), body };
}

const skills: Built[] = [];
for (const kind of SKILL_KINDS) {
	const dir = KIND_DIRS[kind];
	if (!existsSync(join(ROOT, dir))) continue;
	for (const file of readdirSync(join(ROOT, dir)).filter((name) => name.endsWith('.md')).sort()) skills.push(load(dir, file));
}
const seen = new Set<string>();
for (const skill of skills) {
	if (seen.has(skill.name)) throw new Error(`Two skills are named "${skill.name}"; names are unique across kinds.`);
	seen.add(skill.name);
}

const out = `// GENERATED by packages/skills/scripts/build-skills.mts from styles/*.md. Do not edit by hand.
/* eslint-disable */

export const SKILLS = ${JSON.stringify(skills, null, 2)} as const;
`;

const count = `${skills.length} skill${skills.length === 1 ? '' : 's'}`;
if (process.argv.includes('--check')) {
	const current = existsSync(OUT) ? readFileSync(OUT, 'utf8') : '';
	if (current !== out) {
		console.error('packages/skills/src/index.gen.ts is out of date. Run: npm run build --workspace @opencmo/skills');
		process.exit(1);
	}
	console.log(`skills: ${count} ${skills.length === 1 ? 'matches its source' : 'match their sources'}`);
} else {
	writeFileSync(OUT, out);
	console.log(`skills: wrote ${count} to src/index.gen.ts`);
}
